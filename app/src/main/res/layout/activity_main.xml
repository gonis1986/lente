<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lente — Traduttore Schermo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnStartTranslation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  AVVIA TRADUZIONE SCHERMO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnStopTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⏹  Ferma Traduzione"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Tocca 'Avvia Traduzione' per mostrare la barra fluttuante con il tasto '🔄 Traduci' sopra qualsiasi app e tradurre a schermo con un tocco."
            android:textColor="#666666"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="#E5E7EB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_source_lang"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/label_target_lang"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_translate_on_open" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="#E5E7EB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permessi e Assistente"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/a11yStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnEnableA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_enable_a11y" />

        <TextView
            android:id="@+id/assistantStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnSetAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_set_assistant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/hint_trigger"
            android:textSize="12sp"
            android:textColor="#777777" />

    </LinearLayout>
</ScrollView>
